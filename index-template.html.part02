L = M.layers, H = M.heads, HD = D / H;
  const n = S + 1;                                   /* tokens: CLS + 8 segments */
  const h = new Float32Array(n * D);
  for (let i = 0; i < D; i++) h[i] = TR.cls[i] + TR.pos[i];
  for (let s = 0; s < S; s++) {                       /* token projection + positions */
    const to = (s + 1) * D, xo = s * SD;
    for (let i = 0; i < D; i++) {
      let acc = TR.projB[i];
      const wo = i * SD;
      for (let j = 0; j < SD; j++) acc += TR.proj[wo + j] * x[xo + j];
      h[to + i] = acc + TR.pos[to + i];
    }
  }
  const t = new Float32Array(n * D);
  const qkv = new Float32Array(3 * n * D);
  const att = new Float32Array(n * D);
  const ff = new Float32Array(M.ff);
  const sc = new Float32Array(n);
  for (let li = 0; li < L; li++) {
    const B = TR.blocks[li];
    for (let k = 0; k < n; k++) aiLN(t, k * D, h, k * D, B.ln1g, B.ln1b, D);
    for (let k = 0; k < n; k++) {                     /* fused QKV projections */
      const so = k * D, to = k * 3 * D;
      for (let i = 0; i < 3 * D; i++) {
        let acc = B.qkvB[i];
        const wo = i * D;
        for (let j = 0; j < D; j++) acc += B.qkv[wo + j] * t[so + j];
        qkv[to + i] = acc;
      }
    }
    att.fill(0);
    const scale = 1 / Math.sqrt(HD);
    for (let hh = 0; hh < H; hh++) {                  /* scaled dot-product attention */
      const qo = hh * HD, ko = D + hh * HD, vo = 2 * D + hh * HD;
      for (let i = 0; i < n; i++) {
        const qb = i * 3 * D + qo;
        let mx = -Infinity;
        for (let j = 0; j < n; j++) {
          const kb = j * 3 * D + ko;
          let dot = 0;
          for (let d = 0; d < HD; d++) dot += qkv[qb + d] * qkv[kb + d];
          dot *= scale;
          sc[j] = dot;
          if (dot > mx) mx = dot;
        }
        let sum = 0;
        for (let j = 0; j < n; j++) { sc[j] = Math.exp(sc[j] - mx); sum += sc[j]; }
        for (let j = 0; j < n; j++) {
          const p = sc[j] / sum;
          if (p === 0) continue;
          const vb = j * 3 * D + vo, ob = i * D + hh * HD;
          for (let d = 0; d < HD; d++) att[ob + d] += p * qkv[vb + d];
        }
      }
    }
    for (let k = 0; k < n; k++) {                     /* output projection + residual */
      const ao = k * D;
      for (let i = 0; i < D; i++) {
        let acc = B.outB[i];
        const wo = i * D;
        for (let j = 0; j < D; j++) acc += B.out[wo + j] * att[ao + j];
        h[ao + i] += acc;
      }
    }
    for (let k = 0; k < n; k++) aiLN(t, k * D, h, k * D, B.ln2g, B.ln2b, D);
    for (let k = 0; k < n; k++) {                     /* FFN 336->1344->336 (ReLU) + residual */
      const to = k * D;
      for (let i = 0; i < M.ff; i++) {
        let acc = B.b1[i];
        const wo = i * D;
        for (let j = 0; j < D; j++) acc += B.w1[wo + j] * t[to + j];
        ff[i] = acc > 0 ? acc : 0;
      }
      for (let i = 0; i < D; i++) {
        let acc = B.b2[i];
        const wo = i * M.ff;
        for (let j = 0; j < M.ff; j++) acc += B.w2[wo + j] * ff[j];
        h[to + i] += acc;
      }
    }
  }
  const c = new Float32Array(D);                     /* final LN on the CLS token */
  aiLN(c, 0, h, 0, TR.lnFg, TR.lnFb, D);
  const out = new Float32Array(4);
  for (let i = 0; i < 4; i++) {
    let acc = TR.headB[i];
    const wo = i * D;
    for (let j = 0; j < D; j++) acc += TR.head[wo + j] * c[j];
    out[i] = 1 / (1 + Math.exp(-acc));
  }
  return out;
}

let AI_TOKEN_REV = null;
function aiTokenRev() {
  if (!AI_TOKEN_REV) {
    AI_TOKEN_REV = {};
    for (const t in AI_MODEL.tokenVocab) {
      const i = AI_MODEL.tokenVocab[t];
      (AI_TOKEN_REV[i] = AI_TOKEN_REV[i] || []).push(t);
    }
  }
  return AI_TOKEN_REV;
}

/* FNV-1a 32-bit — must match the Python training implementation byte-for-byte */
function aiHash(str) {
  let h = 0x811c9dc5 >>> 0;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h >>> 0;
}

/* Build the model input from the scan result. The 48 numeric features are a
   fixed contract with the training script (train_ai.py, gen_batch). */
function aiExtract(urlStr, page) {
  const D = AI_MODEL.hashDim, NF = AI_MODEL.nFeat;
  let uo; try { uo = new URL(urlStr); } catch (e) { return null; }
  const host = uo.hostname.toLowerCase();
  const f = new Array(NF).fill(0);
  const html = (page && page.html) ? page.html : "";
  const doc = html ? new DOMParser().parseFromString(html, "text/html") : null;

  /* 0-12: URL features */
  f[0]  = Math.min(urlStr.length / 200, 1);
  f[1]  = Math.min(host.length / 60, 1);
  const digits = (host.match(/[0-9]/g) || []).length;
  f[2]  = host.length ? digits / host.length : 0;
  f[3]  = Math.min((host.match(/-/g) || []).length / 6, 1);
  f[4]  = Math.min(Math.max(0, host.split(".").length - 2) / 5, 1);
  f[5]  = /^\d+\.\d+\.\d+\.\d+$/.test(host) ? 1 : 0;
  f[6]  = /\.(tk|ml|ga|cf|gq|xyz|top|buzz|click|link|work|rest|fit|country|stream|download|gdn|racing|loan|men|party|review|science|webcam|site|icu|cam)$/i.test(host) ? 1 : 0;
  f[7]  = host.indexOf("xn--") !== -1 ? 1 : 0;
  f[8]  = uo.protocol === "https:" ? 1 : 0;
  f[9]  = Math.min(uo.pathname.split("/").filter(Boolean).length / 8, 1);
  f[10] = Math.min((uo.search || "").length / 100, 1);
  f[11] = urlStr.indexOf("@") !== -1 ? 1 : 0;
  f[12] = /login|signin|verify|account|secure|update|password|wallet|bank/i.test(urlStr) ? 1 : 0;

  /* 13-47: page features (0.5 = unknown, mirrors training augmentation) */
  if (!doc) {
    for (let j = 13; j < NF; j++) f[j] = 0.5;
  } else {
    const tEl = doc.querySelector("title");
    const t = tEl ? tEl.textContent.trim() : "";
    const md = doc.querySelector('meta[name="description" i]');
    const d = md ? (md.getAttribute("content") || "").trim() : "";
    f[13] = t ? 1 : 0;
    f[14] = Math.min(t.length / 80, 1);
    f[15] = d ? 1 : 0;
    f[16] = Math.min(d.length / 300, 1);
    f[17] = doc.querySelector('meta[name="viewport" i]') ? 1 : 0;
    f[18] = (doc.querySelector("meta[charset i]") || /charset=/i.test(html.slice(0, 2000))) ? 1 : 0;
    f[19] = doc.documentElement.getAttribute("lang") ? 1 : 0;
    f[20] = doc.querySelector('link[rel*="icon" i]') ? 1 : 0;
    f[21] = Math.min(doc.querySelectorAll("h1").length / 5, 1);
    const imgs = doc.querySelectorAll("img");
    f[22] = Math.min(imgs.length / 100, 1);
    f[23] = imgs.length ? doc.querySelectorAll('img:not([alt]), img[alt=""]').length / imgs.length : 0;
    f[24] = Math.min(doc.querySelectorAll("[style]").length / 50, 1);
    f[25] = Math.min(doc.querySelectorAll("script").length / 40, 1);
    f[26] = Math.min(doc.querySelectorAll("iframe").length / 5, 1);
    f[27] = Math.min(doc.querySelectorAll("form").length / 5, 1);
    f[28] = doc.querySelector('input[type="password" i]') ? 1 : 0;
    const actHttp = Array.from(doc.querySelectorAll("form"))
      .some(fm => /^http:\/\//i.test((fm.getAttribute("action") || "").trim()));
    f[29] = ((f[8] === 0 && f[28] === 1) || actHttp) ? 1 : 0;
    f[30] = Math.min((html.match(/(?:src|href)\s*=\s*["']http:\/\/(?!www\.w3\.org|schemas\.xmlsoap|purl\.org)/gi) || []).length / 10, 1);
    f[31] = Math.min((html.match(/\son\w+\s*=/gi) || []).length / 50, 1);
    const jq = html.match(/jquery[.\-\/]?(\d+)\.(\d+)/i);
    f[32] = (jq || /jquery/i.test(html)) ? 1 : 0;
    f[33] = jq ? Math.min(parseInt(jq[1], 10) / 3, 1) : 0;
    f[34] = Math.min(["center", "font", "marquee", "frameset", "frame", "big", "strike", "applet"]
      .reduce((a, tg) => a + doc.getElementsByTagName(tg).length, 0) / 5, 1);
    const blanks = doc.querySelectorAll('a[target="_blank"]');
    let unsafe = 0;
    blanks.forEach(a => { if (!((a.getAttribute("rel") || "").toLowerCase().includes("noopener"))) unsafe++; });
    f[35] = blanks.length ? unsafe / blanks.length : 0;
    f[36] = Math.min((html.match(/\beval\s*\(/g) || []).length / 10, 1);
    f[37] = Math.min(((html.match(/\batob\s*\(/g) || []).length +
                      (html.match(/unescape\s*\(/g) || []).length +
                      (html.match(/fromCharCode/g) || []).length +
                      (html.match(/document\.write/g) || []).length) / 10, 1);
    f[38] = /[0-9a-fA-F]{32,}/.test(html.replace(/https?:\/\/[^\s"']+/g, "")) ? 1 : 0;
    const kws = ["verify your account", "account suspended", "wallet", "bitcoin", "seed phrase",
                 "gift card", "you have won", "prize", "unlock your", "limited time", "act now", "urgent"];
    const bodyTxt = (doc.body ? doc.body.textContent : "").toLowerCase().slice(0, 4000);
    f[39] = Math.min(kws.reduce((a, k) => a + (bodyTxt.split(k).length - 1), 0) / 8, 1);
    f[40] = /coinhive|cryptonight|stratum\s*\+?\s*tcp|miner\.js|webminer/i.test(html) ? 1 : 0;
    const srcs = Array.from(doc.querySelectorAll("script[src]"));
    f[41] = Math.min(srcs.length / 20, 1);
    f[42] = srcs.length ? srcs.filter(s => /^http:\/\//i.test(s.getAttribute("src") || "")).length / srcs.length : 0;
    const h = (page && page.headers) || {};
    f[43] = ("content-security-policy" in h) ? (h["content-security-policy"] ? 1 : 0) : 0.5;
    f[44] = ("strict-transport-security" in h) ? (h["strict-transport-security"] ? 1 : 0) : 0.5;
    f[45] = ("x-frame-options" in h) ? (h["x-frame-options"] ? 1 : 0) : 0.5;
    f[46] = doc.querySelector('meta[http-equiv="refresh" i]') ? 1 : 0;
    f[47] = Math.min(doc.querySelectorAll('input[type="password" i]').length, 1);
  }

  /* hashed bag-of-tokens */
  const toks = new Set();
  const addToks = (s, cap) => {
    (String(s).toLowerCase().match(/[a-z0-9]{3,30}/g) || []).slice(0, cap).forEach(t => toks.add(t));
  };
  addToks(host.replace(/\./g, " ") + " " + uo.pathname, 40);
  if (doc) {
    const tEl = doc.querySelector("title");
    if (tEl) addToks(tEl.textContent, 20);
    if (doc.body) addToks(doc.body.textContent, 200);
    doc.querySelectorAll("script[src]").forEach(s => addToks(s.getAttribute("src") || "", 10));
  }

  const x = new Float32Array(D + NF);
  toks.forEach(t => { x[aiHash(t) % D] = 1; });
  for (let j = 0; j < NF; j++) x[D + j] = f[j];
  return { x, f, tokens: Array.from(toks).slice(0, 250) };
}

/* saliency-based explanation: which inputs pushed the winning class */
function aiExplain(ex, ci) {
  const D = AI_MODEL.hashDim;
  const sal = TR.SAL[ci];
  const rev = aiTokenRev();
  const items = [];
  const seen = {};
  for (const tok of ex.tokens) {
    const idx = aiHash(tok) % D;
    const names = rev[idx];
    if (!names) continue;
    const v = sal[idx];
    if (v > 0 && !seen[names[0]]) { seen[names[0]] = 1; items.push({ name: names[0], v }); }
  }
  for (let j = 0; j < AI_MODEL.nFeat; j++) {
    const v = sal[D + j] * ex.f[j];
    if (v > 0 && !seen[AI_MODEL.featNames[j]]) { seen[AI_MODEL.featNames[j]] = 1; items.push({ name: AI_MODEL.featNames[j], v }); }
  }
  items.sort((a, b) => b.v - a.v);
  return items.slice(0, 6);
}

function aiLevel(p) {
  return p >= 0.7 ? ["hi", "HIGH"] : p >= 0.45 ? ["ele", "ELEVATED"] : p >= 0.2 ? ["mod", "MODERATE"] : ["low", "LOW"];
}

function runAiAnalysis(urlStr, page) {
  const ex = aiExtract(urlStr, page);
  if (!ex) return;
  const probs = aiForward(ex.x);

  const bars = $("aiBars");
  bars.innerHTML = "";
  for (let c = 0; c < probs.length; c++) {
    const p = probs[c];
    const cls = aiLevel(p)[0], lvName = aiLevel(p)[1];
    const row = document.createElement("div");
    row.className = "ai-row";
    row.innerHTML =
      '<div class="ai-label">' + esc(AI_MODEL.labels[c]) + "</div>" +
      '<div class="ai-track"><div class="ai-fill" data-p="' + p + '"></div></div>' +
      '<div class="ai-pct">' + Math.round(p * 100) + "%</div>" +
      '<div class="ai-level ' + cls + '">' + lvName + "</div>";
    bars.appendChild(row);
  }
  bars.querySelectorAll(".ai-fill").forEach(el => {
    const p = parseFloat(el.dataset.p);
    el.style.width = (p * 100) + "%";
    el.style.background = p >= 0.7 ? "var(--red)" : p >= 0.45 ? "var(--orange)" : p >= 0.2 ? "var(--yellow)" : "var(--green)";
  });

  let best = 0;
  for (let c = 1; c < probs.length; c++) if (probs[c] > probs[best]) best = c;
  const sig = aiExplain(ex, best);
  const sc = $("aiSignals");
  sc.innerHTML = "";
  const maxv = sig.length ? sig[0].v : 1;
  sig.forEach(s => {
    const chip = document.createElement("span");
    chip.className = "ai-chip";
    chip.textContent = s.name + "  +" + Math.round(100 * s.v / maxv) + "%";
    sc.appendChild(chip);
  });

  $("aiPanel").style.display = "block";
  window.__AI = { probabilities: {}, signals: sig.map(s => s.name) };
  AI_MODEL.labels.forEach((l, c) => { window.__AI.probabilities[l] = Math.round(probs[c] * 100) / 100; });

  log("[+] AI: phishing " + Math.round(probs[0] * 100) + "% | malware " + Math.round(probs[1] * 100) +
      "% | outdated " + Math.round(probs[2] * 100) + "% | quality " + Math.round(probs[3] * 100) + "%", "ok");

  const maxP = Math.max.apply(null, Array.from(probs));
  if (maxP >= 0.6) {
    const bestL = AI_MODEL.labels[best];
    addFinding(maxP >= 0.85 ? "high" : "medium",
      "AI model flags " + bestL.toLowerCase() + " risk (" + Math.round(maxP * 100) + "%)",
      "Neural network assessment",
      "The embedded " + AI_MODEL.params.toLocaleString() + "-parameter neural network estimates a " +
      Math.round(maxP * 100) + "% probability that this site matches the '" + bestL +
      "' profile. Top contributing signals: " + (sig.slice(0, 4).map(s => s.name).join(", ") || "n/a") + ".",
      "Treat the AI score as a lead, not proof — verify against the concrete rule findings above and manual review. If this profile is expected for your site, you can ignore it.",
      null);
  }
}

/* ============================== wiring ============================== */

$("scanBtn").addEventListener("click", () => runScan($("url").value));
$("url").addEventListener("keydown", e => { if (e.key === "Enter") runScan($("url").value); });
$("rescanBtn").addEventListener("click", () => {
  $("summary").style.display = "none";
  runScan($("url").value);
});
$("exportBtn").addEventListener("click", () => {
  if (!LAST_REPORT) return;
  const blob = new Blob([JSON.stringify(LAST_REPORT, null, 2)], { type: "application/json" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "bughunter-report.json";
  a.click();
  URL.revokeObjectURL(a.href);
});

/* ============================== scan history (v2) ============================== */

const HIST_KEY = "bughunter_history_v2";

function loadHistory() {
  try { return JSON.parse(localStorage.getItem(HIST_KEY) || "[]"); } catch (e) { return []; }
}

function saveHistory(url, score) {
  try {
    let h = loadHistory().filter(e => e.url !== url);
    h.unshift({ url: url, score: score, at: new Date().toISOString() });
    h = h.slice(0, 8);
    localStorage.setItem(HIST_KEY, JSON.stringify(h));
  } catch (e) {}
  renderHistory();
}

function renderHistory() {
  const box = $("historyBox");
  if (!box) return;
  const h = loadHistory();
  if (!h.length) { box.style.display = "none"; return; }
  box.style.display = "block";
  const row = $("histRow");
  row.innerHTML = "";
  h.forEach(e => {
    if (!e || !e.url) return;
    const score = Math.round(e.score || 0);
    const col = score >= 80 ? "var(--green)" : score >= 60 ? "var(--yellow)" : score >= 40 ? "var(--orange)" : "var(--red)";
    const chip = document.createElement("span");
    chip.className = "hist-chip";
    chip.innerHTML = '<b style="color:' + col + '">' + score + '</b> · ' +
      esc(String(e.url).replace(/^https?:\/\//, "").replace(/\/$/, ""));
    chip.title = "Rescan " + e.url;
    chip.addEventListener("click", () => { $("url").value = e.url; runScan(e.url); });
    row.appendChild(chip);
  });
}
$("histClear").addEventListener("click", () => {
  try { localStorage.removeItem(HIST_KEY); } catch (e) {}
  renderHistory();
});
renderHistory();

/* ============================== assistant chat (v3.5) ============================== */
/* Fully offline rule-based assistant: answers from a built-in knowledge base
   and YOUR current scan results. No network calls, no data collection. */

const CHAT_KB = [
  { keys: ["content security policy", "csp"],
    text: "Content-Security-Policy (CSP) is a response header that tells the browser exactly which sources a page may load scripts, styles and frames from. Without it, any injected script runs freely, which makes every XSS bug far more damaging. It's one of the highest-value security headers a site can add.",
    fix: "Content-Security-Policy: default-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'" },
  { keys: ["hsts", "strict transport"],
    text: "Strict-Transport-Security (HSTS) forces the browser to always use HTTPS for your domain, even if a user clicks or types an http:// link. Without it, a man-in-the-middle can 'SSL-strip' the connection on a hostile network (café Wi-Fi, rogue hotspot).",
    fix: "Strict-Transport-Security: max-age=31536000; includeSubDomains" },
  { keys: ["sri", "subresource", "integrity"],
    text: "Subresource Integrity (SRI) pins a cryptographic hash of each external script/stylesheet. If the CDN or the library is compromised and the file changes by even one bit, the browser refuses to run it. The 2018 Ticketmaster breach was exactly a compromised third-party script without SRI.",
    fix: '<script src="https://cdn.example.com/lib.js" integrity="sha384-<hash>" crossorigin="anonymous"><\/script>' },
  { keys: ["mixed content", "mixed-content"],
    text: "Mixed content means an HTTPS page loading scripts, styles or images over plain http://. Browsers silently block the active kinds — so parts of your page just break — and the padlock is stripped. Upgrade every resource URL to https://." },
  { keys: ["tabnabbing", "noopener", "target _blank", "target blank"],
    text: "Reverse tabnabbing: a link with target=\"_blank\" but no rel=\"noopener\" gives the opened page a handle on window.opener — it can silently redirect YOUR tab to a phishing clone. Always add rel=\"noopener noreferrer\"." },
  { keys: ["phishing"],
    text: "Phishing signatures this scanner looks for: brand-name domains in odd TLDs (e.g. paypal-login.xyz), punycode (xn--) lookalikes, urgency wording ('verify your account', 'act now'), login pages served over plain HTTP, and credential keywords in URLs. The AI head reports a probability — treat it as a lead, not proof." },
  { keys: ["jquery"],
    text: "jQuery 1.x and 2.x have publicly known XSS and prototype-pollution CVEs (e.g. CVE-2020-11022/11023 in versions < 3.5). Attackers actively scan the web for old jQuery. Upgrade to the latest 3.x — the API is largely compatible." },
  { keys: ["cls", "layout shift", "cumulative"],
    text: "Cumulative Layout Shift (CLS) is a Core Web Vitals metric. Images without width/height attributes force the browser to reflow the page as they load, so content jumps around while users try to click. Always set dimensions (or a CSS aspect-ratio) on every <img>." },
  { keys: ["canonical"],
    text: "A canonical URL (rel=canonical) tells search engines which variant of a page is the 'real' one. Without it, www/non-www, http/https and query-string duplicates each get indexed separately, splitting your ranking across copies." },
  { keys: ["alt text", "alt attribute", "screen reader", "accessibility", "wcag", "a11y"],
    text: "Accessibility basics the scanner checks: alt text on images, labels on form inputs, one clear <h1>, a lang attribute, descriptive link text, and no unlabeled icon-only buttons. These are WCAG requirements, legally enforced in many countries — and they help SEO too." },
  { keys: ["robots", "sitemap"],
    text: "robots.txt tells crawlers what to skip and points to your sitemap.xml; the sitemap helps search engines discover all your pages. Both are optional but cheap wins for SEO." },
  { keys: ["neural", "machine learning", "how does the ai", "how does your ai", "llm", "transformer", "real ai"],
    text: "The AI risk layer is a REAL transformer — an 8,269,972-parameter encoder: the page's tokens and features become 8 embedded segments that pass through 6 layers of multi-head self-attention (8 heads, 336-dim) with a 336→1344→336 feed-forward network, ending in 4 sigmoid heads. It's int8-quantized and embedded in this page; inference runs locally on typed arrays. The chat you're using now is a large language model (online) with this page's rule engine and knowledge base as fallback." },
  { keys: ["privacy", "offline", "data leave", "does this send", "where does my data", "do you collect"],
    text: "BugHunter runs in two modes. The scanner, AI risk transformer and Thoughts view always run 100% locally in your browser. The chat has two modes: ONLINE (default) sends your question plus a short scan summary to a third-party AI service so a large language model can answer — nothing else is collected; OFFLINE (click the label in the chat header) answers only from the built-in knowledge base and sends nothing anywhere. Scan history stays in your browser's localStorage either way." },
  { keys: ["penetration", "pentest", "pen test"],
    text: "BugHunter is a passive, surface-level scanner: it reads what any visitor's browser can read. A penetration test actively probes, exploits and chains vulnerabilities with human judgment. Use this as a quick first pass — it is not a replacement for a real pentest." },
  { keys: ["xss", "cross site scripting", "cross-site scripting"],
    text: "Cross-Site Scripting (XSS) is injecting JavaScript into a page so it runs in other users' browsers — it can steal sessions, log keystrokes or deface the site. The fix is threefold: escape all output by context (HTML, attribute, JS), sanitize/validate all input, and add a Content-Security-Policy as a safety net. Never use innerHTML with untrusted strings — use textContent.",
    fix: "// bad:  el.innerHTML = userInput;  // good: el.textContent = userInput;" },
  { keys: ["sql injection", "sqli", "sql query"],
    text: "SQL injection happens when user input is concatenated into a query, letting attackers read or destroy your database. It's #1 on most bug-bounty lists. The fix: always use parameterized queries / prepared statements — never build SQL with string concatenation — and apply least-privilege database permissions.",
    fix: "Python: cur.execute(\"SELECT ... WHERE name=%s\", (name,))  — never concatenate input into SQL." },
  { keys: ["csrf", "cross site request forgery", "cross-site request forgery"],
    text: "CSRF tricks a logged-in user's browser into sending unwanted requests to your site (e.g. transferring money). Defenses: anti-CSRF tokens on every state-changing form, SameSite cookies (Lax or Strict), and verifying the Origin header on sensitive requests.",
    fix: "Set-Cookie: session=abc; HttpOnly; Secure; SameSite=Lax" },
  { keys: ["tls", "ssl certificate", "ssl cert", "https certificate"],
    text: "TLS is the padlock — it encrypts traffic and proves your identity. Common bugs: expired certificates, mixed content, no HTTP→HTTPS redirect, missing HSTS. Free certificates are available from Let's Encrypt with automatic renewal (certbot). Check yours with your browser's padlock icon or SSL Labs' free test." },
  { keys: ["cors"],
    text: "CORS (Cross-Origin Resource Sharing) is the browser's rulebook for which sites may read responses from yours. The classic security bug: Access-Control-Allow-Origin: * on responses that carry cookies or private data, or reflecting arbitrary origins with credentials allowed. Allow only the specific origins that need access, and never combine a wildcard with credentials." },
  { keys: ["cookie", "cookies", "samesite", "httponly"],
    text: "Cookie security basics: mark session cookies HttpOnly (blocks JavaScript theft — the main XSS payload), Secure (HTTPS only), and SameSite=Lax/Strict (blocks most CSRF). Prefix important cookie names with __Host- to prevent injection from subdomains.",
    fix: "Set-Cookie: session=xyz; HttpOnly; Secure; SameSite=Lax; Path=/" },
  { keys: ["2fa", "mfa", "two factor", "two-factor"],
    text: "Two-factor authentication protects accounts even when passwords leak. Website-side bugs to avoid: revealing whether a username exists before the second factor, not rate-limiting OTP attempts, and allowing infinite 2FA retries. Apps (TOTP) or passkeys are safer than SMS codes." },
  { keys: ["backup", "backups", "restore"],
    text: "A site without backups is one bad deploy or hack away from zero. The 3-2-1 rule: 3 copies, 2 different media, 1 off-site. Automate database dumps, keep source in git, and actually TEST a restore — an untested backup is a hope, not a backup." },
  { keys: ["who are you", "what can you do", "what are you", "your name"],
    text: "I'm the BugHunter assistant. In online mode I'm powered by a large language model that can answer general questions and reason about YOUR scan results; if the AI service is unreachable I answer from a built-in web-security knowledge base. Ask me what to fix first, what any finding means, or general web-security questions (XSS, SQL injection, CSRF, CSP, TLS…)." },
];

function chatAnswer(qRaw) {
  const q = " " + qRaw.toLowerCase().replace(/[^a-z0-9\s]/g, " ").replace(/\s+/g, " ") + " ";
  const hasScan = !!LAST_REPORT;

  if (/^\s*(hi|hello|hey|yo|namaste|hola)\b/.test(q) && q.trim().length < 14) {
    return "Hello! I'm the BugHunter assistant — fully offline, running inside this page. " + (hasScan
      ? "You've scanned " + LAST_REPORT.target + " (score " + LAST_REPORT.score + "/100). Ask me about any finding, the score, the AI model, or what to fix first."
      : "Type a domain above and hit RUN SCAN, then ask me anything about the results — or ask about web security topics like CSP, SRI, HSTS or phishing.");
  }

  if (/thank/.test(q)) return "You're welcome! Ping me any time — I don't even need a network connection to answer. ◆";

  const scoreText = "Every site starts at 100. Each finding deducts points by severity: critical −25, high −14, medium −7, low −3 (info findings deduct nothing). The result is clamped to 0–100.";
  if (/score/.test(q)) {
    return scoreText + (hasScan ? "\n\nYour current score: " + LAST_REPORT.score + "/100." : "\n\nRun a scan and I'll tell you your score.");
  }

  if (hasScan && /(fix|start|first|priorit|top|important|worst|critical)/.test(q)) {
    const order = ["critical", "high", "medium", "low"];
    const top = order.flatMap(s => FINDINGS.filter(f => f.sev === s)).slice(0, 3);
    if (!top.length) return "Nothing to fix — the last scan came back clean. 🎉 Keep dependencies updated and re-scan after big changes.";
    let out = "Fix these first, in order:";
    top.forEach((f, i) => {
      out += "\n\n" + (i + 1) + ". [" + f.sev.toUpperCase() + "] " + f.title + "\n   → " + f.fix;
    });
    return out;
  }

  if (hasScan && /(summary|overview|report|results?)/.test(q)) {
    const counts = {};
    for (const f of FINDINGS) counts[f.sev] = (counts[f.sev] || 0) + 1;
    return "Scan of " + LAST_REPORT.target + " — score " + LAST_REPORT.score + "/100\nFindings: " +
      (FINDINGS.length ? Object.keys(counts).map(s => counts[s] + " " + s).join(", ") : "none") + "." +
      (TECH.length ? "\nDetected stack: " + TECH.join(", ") + "." : "") +
      (window.__AI ? "\nAI risk: phishing " + Math.round((window.__AI.probabilities["Phishing / scam"] || 0) * 100) +
        "%, malware " + Math.round((window.__AI.probabilities["Malware / compromise"] || 0) * 100) + "%" : "");
  }

  if (hasScan && /(safe|secure|risky|danger|should i worry)/.test(q)) {
    const counts = {};
    for (const f of FINDINGS) counts[f.sev] = (counts[f.sev] || 0) + 1;
    if (counts.critical) return "There " + (counts.critical === 1 ? "is 1 CRITICAL finding" : "are " + counts.critical + " CRITICAL findings") + " — treat those as urgent (exposed secrets, credentials over HTTP). Fix them before anything else.";
    if (counts.high) return "No critical issues, but " + counts.high + " HIGH finding(s). These are real security weaknesses (missing TLS/CSP, supply-chain risk) — fix them soon.";
    if (FINDINGS.length) return "No critical or high findings — the issues found are quality and polish level. The site's fundamentals look reasonable.";
    return "The last scan was clean. Just keep dependencies updated and re-scan after changes.";
  }

  let best = null, bestScore = 0;
  for (const k of CHAT_KB) {
    let sc = 0;
    for (const key of k.keys) if (q.includes(key)) sc += key.length;
    if (sc > bestScore) { bestScore = sc; best = k; }
  }
  if (best) return best.text + (best.fix ? "\n\nExample:\n" + best.fix : "");

  if (hasScan) {
    for (const f of FINDINGS) {
      const words = (f.title.toLowerCase().match(/[a-z]{4,}/g) || []).filter(w => q.includes(" " + w + " ") || q.startsWith(" " + w));
      if (words.length) {
        return "[" + f.sev.toUpperCase() + "] " + f.title + "\n\n" + f.desc + "\n\nFix: " + f.fix + (f.code ? "\n\n" + f.code : "");
      }
    }
  }

  return "I'm an offline assistant focused on this scan and web-security basics, so I may not know that one. Try:\n• \"what should I fix first\"\n• \"explain my score\"\n• \"what is CSP / SRI / HSTS?\"\n• \"is my site safe?\"\n• \"how does the AI work?\"";
}

(function chatInit() {
  const chatBody = $("chatBody");
  function chatAdd(text, who) {
    const m = document.createElement("div");
    m.className = "chat-msg " + who;
    m.textContent = text;
    chatBody.appendChild(m);
    chatBody.scrollTop = chatBody.scrollHeight;
  }
  function chatTyping() {
    const t = document.createElement("div");
    t.className = "chat-msg bot chat-typing";
    t.innerHTML = "<span></span><span></span><span></span>";
    chatBody.appendChild(t);
    chatBody.scrollTop = chatBody.scrollHeight;
    return t;
  }
  let chatBusy = false;
  let CHAT_ONLINE = true;
  function setChatMode(online) {
    CHAT_ONLINE = online;
    $("chatModeLbl").textContent = online
      ? "⚡ online AI · ask anything — click to switch to offline KB"
      : "⌂ offline knowledge base — click to switch to online AI";
  }
  /* Ask a real large language model, with the current scan as context.
     Falls back to the built-in knowledge base when unreachable. */
  async function askOnline(q) {
    let ctx = "";
    if (LAST_REPORT) {
      ctx = "The user has scanned " + LAST_REPORT.target + " with BugHunter; score " + LAST_REPORT.score + "/100.";
      if (FINDINGS.length) ctx += " Findings so far: " + FINDINGS.slice(0, 8).map(f => "[" + f.sev + "] " + f.title).join("; ") + ".";
      if (window.__AI) {
        const P = window.__AI.probabilities;
        ctx += " Transformer AI risk: phishing " + Math.round((P["Phishing / scam"] || 0) * 100) +
          "%, malware " + Math.round((P["Malware / compromise"] || 0) * 100) +
          "%, outdated " + Math.round((P["Outdated & insecure stack"] || 0) * 100) +
          "%, poor quality " + Math.round((P["Poor quality / SEO"] || 0) * 100) + ".";
      }
    } else {
      ctx = "The user has not scanned a site yet.";
    }
    const sys = "You are the assistant inside BugHunter, a browser-based website security scanner. " + ctx +
      " Answer concisely (under 120 words), be practical and specific; include concrete fixes or short code examples when relevant; be honest when unsure.";
    const url = "https://text.pollinations.ai/" + encodeURIComponent(q) +
      "?model=openai&system=" + encodeURIComponent(sys);
    const ctrl = new AbortController();
    const tm = setTimeout(() => ctrl.abort(), 20000);
    try {
      const r = await fetch(url, { signal: ctrl.signal });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const txt = (await r.text()).trim();
      if (!txt || txt.length < 2) throw new Error("empty");
      return txt.slice(0, 2500);
    } finally {
      clearTimeout(tm);
    }
  }
  async function chatSendMsg() {
    const inp = $("chatInput");
    const v = inp.value.trim();
    if (!v || chatBusy) return;
    inp.value = "";
    chatAdd(v, "user");
    chatBusy = true;
    const t = chatTyping();
    let ans = null;
    if (CHAT_ONLINE) {
      try { ans = await askOnline(v); } catch (e) { ans = null; }
    }
    t.remove();
    if (ans === null) {
      try { ans = chatAnswer(v); } catch (e) { ans = "Something went wrong answering that — try another question."; }
      if (CHAT_ONLINE) ans += "\n\n— [AI service unreachable; answered from the built-in knowledge base. Click the label above to stay offline.]";
    }
    chatAdd(ans, "bot");
    chatBusy = false;
  }
  $("chatFab").addEventListener("click", () => {
    const p = $("chatPanel");
    const open = p.classList.toggle("open");
    $("chatFab").textContent = open ? "✕" : "💬";
    if (open) {
      if (!chatBody.children.length) {
        chatAdd("Hi! I'm the BugHunter assistant — in online mode I'm powered by a large language model, with your scan results as context, so ask me anything. If the AI service can't be reached I'll answer from the built-in security knowledge base.", "bot");
      }
      $("chatInput").focus();
    }
  });
  $("chatClose").addEventListener("click", () => {
    $("chatPanel").classList.remove("open");
    $("chatFab").textContent = "💬";
  });
  $("chatModeLbl").addEventListener("click", () => setChatMode(!CHAT_ONLINE));
  $("chatSend").addEventListener("click", chatSendMsg);
  $("chatInput").addEventListener("keydown", e => { if (e.key === "Enter") chatSendMsg(); });
  ["Explain my score", "What should I fix first?", "Is my site safe?", "What is XSS?", "How does the AI work?", "What is SRI?"].forEach(s => {
    const c = document.createElement("span");
    c.className = "chat-chip";
    c.textContent = s;
    c.addEventListener("click", () => { $("chatInput").value = s; chatSendMsg(); });
    $("chatChips").appendChild(c);
  });
})();
</script>
</body>
</html>
