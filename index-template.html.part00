<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BugHunter â€” Website Bug & Vulnerability Detector</title>
<style>
  :root {
    --bg: #0a0e14;
    --bg-2: #0f1520;
    --card: #131b28;
    --card-2: #182233;
    --border: #22304a;
    --text: #d7e2f0;
    --muted: #7b8ba3;
    --green: #34d399;
    --cyan: #38bdf8;
    --red: #f87171;
    --orange: #fb923c;
    --yellow: #facc15;
    --blue: #60a5fa;
    --mono: "JetBrains Mono", "Fira Code", "SF Mono", Consolas, monospace;
    --sans: "Inter", -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(56,189,248,.08), transparent),
      linear-gradient(rgba(56,189,248,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56,189,248,.025) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
  }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 32px 20px 80px; }

  header { text-align: center; padding: 28px 0 8px; }
  .logo {
    font-family: var(--mono);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .logo .bracket { color: var(--cyan); }
  .logo .cursor { display:inline-block; width:10px; height:22px; background: var(--green); vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .tagline { color: var(--muted); margin-top: 10px; font-size: 14.5px; }
  .tagline b { color: var(--green); font-weight: 600; }

  /* Scan bar */
  .scanbar {
    margin-top: 30px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 10px 40px rgba(0,0,0,.35);
  }
  .scan-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .url-wrap { flex: 1; min-width: 240px; position: relative; }
  .url-wrap .prefix { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); font-family: var(--mono); font-size: 14px; pointer-events: none; }
  #url {
    width: 100%;
    padding: 14px 16px 14px 64px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 15px;
    outline: none;
    transition: border .15s;
  }
  #url:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(56,189,248,.12); }
  #scanBtn {
    padding: 14px 30px;
    background: linear-gradient(135deg, #16a34a, #0d9488);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--mono);
    letter-spacing: .5px;
    transition: transform .1s, opacity .15s;
    white-space: nowrap;
  }
  #scanBtn:hover { transform: translateY(-1px); }
  #scanBtn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  .hint { color: var(--muted); font-size: 12.5px; margin-top: 10px; font-family: var(--mono); }

  /* Terminal log */
  #terminal {
    display: none;
    margin-top: 18px;
    background: #060a10;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px 16px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
    max-height: 220px;
    overflow-y: auto;
  }
  #terminal .ok { color: var(--green); }
  #terminal .warn { color: var(--yellow); }
  #terminal .err { color: var(--red); }
  #terminal .info { color: var(--muted); }
  .progress-track { display:none; margin-top: 14px; height: 6px; background: var(--bg-2); border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--cyan), var(--green)); transition: width .4s ease; }

  /* Summary */
  #summary { display: none; margin-top: 26px; }
  .score-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 26px;
    display: flex;
    gap: 30px;
    align-items: center;
    flex-wrap: wrap;
  }
  .gauge { position: relative; width: 130px; height: 130px; flex-shrink: 0; }
  .gauge svg { transform: rotate(-90deg); }
  .gauge .val {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .gauge .val b { font-size: 34px; font-family: var(--mono); }
  .gauge .val span { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
  .counts { flex: 1; min-width: 220px; }
  .counts h2 { font-size: 18px; margin-bottom: 4px; font-weight: 600; }
  .counts .target { color: var(--muted); font-family: var(--mono); font-size: 13px; margin-bottom: 16px; word-break: break-all; }
  .pill-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .pill {
    padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
    font-family: var(--mono); border: 1px solid transparent;
  }
  .pill.critical { background: rgba(248,113,113,.12); color: var(--red); border-color: rgba(248,113,113,.35); }
  .pill.high { background: rgba(251,146,60,.12); color: var(--orange); border-color: rgba(251,146,60,.35); }
  .pill.medium { background: rgba(250,204,21,.1); color: var(--yellow); border-color: rgba(250,204,21,.3); }
  .pill.low { background: rgba(96,165,250,.1); color: var(--blue); border-color: rgba(96,165,250,.3); }
  .pill.info { background: rgba(123,139,163,.12); color: var(--muted); border-color: rgba(123,139,163,.3); }
  .pill.pass { background: rgba(52,211,153,.1); color: var(--green); border-color: rgba(52,211,153,.3); }
  .summary-actions { margin-top: 22px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn2 {
    padding: 10px 18px; background: var(--bg-2); color: var(--text);
    border: 1px solid var(--border); border-radius: 8px; cursor: pointer;
    font-family: var(--mono); font-size: 13px; transition: border .15s;
  }
  .btn2:hover { border-color: var(--cyan); }

  /* Tech chips */
  #techBox { display: none; margin-top: 22px; }
  #techBox h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); margin-bottom: 12px; font-family: var(--mono); }
  .chips { display: flex; flex-wrap: wrap; gap: 9px; }
  .chip {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 8px 14px; font-size: 13px; font-family: var(--mono);
    display: flex; align-items: center; gap: 8px;
  }
  .chip .dot { width: 7px; height:ÜÈ›Ü™\‹\˜Y]\ÎˆL	NÈ˜XÚÙÜ›İ[™ˆ˜\ŠKXŞX[ŠNÈB‚ˆÊˆš[™[™ÜÈ
