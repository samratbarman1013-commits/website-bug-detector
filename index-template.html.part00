<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BugHunter v4.5 — Website Bug & Vulnerability Detector</title>
<style>
  :root {
    --bg: #0a0e14;
    --bg-2: #0f1520;
    --card: #131b28;
    --card-2: #182233;
    --border: #22304a;
    --text: #d7e2f0;
    --muted: #7b8ba3;
    --green: #34d399;
    --cyan: #38bdf8;
    --red: #f87171;
    --orange: #fb923c;
    --yellow: #facc15;
    --blue: #60a5fa;
    --mono: "JetBrains Mono", "Fira Code", "SF Mono", Consolas, monospace;
    --sans: "Inter", -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    background-image:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(56,189,248,.08), transparent),
      linear-gradient(rgba(56,189,248,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56,189,248,.025) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
  }
  .wrap { max-width: 1000px; margin: 0 auto; padding: 32px 20px 80px; }

  header { text-align: center; padding: 28px 0 8px; }
  .logo {
    font-family: var(--mono);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .logo .bracket { color: var(--cyan); }
  .logo .cursor { display:inline-block; width:10px; height:22px; background: var(--green); vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .tagline { color: var(--muted); margin-top: 10px; font-size: 14.5px; }
  .tagline b { color: var(--green); font-weight: 600; }
  .logo .ver {
    font-size: 13px; color: var(--green); border: 1px solid rgba(52,211,153,.5);
    border-radius: 5px; padding: 2px 7px; vertical-align: 6px; margin: 0 2px;
    background: rgba(52,211,153,.08); letter-spacing: 1px;
  }

  /* Scan bar */
  .scanbar {
    margin-top: 30px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 10px 40px rgba(0,0,0,.35);
  }
  .scan-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .url-wrap { flex: 1; min-width: 240px; position: relative; }
  .url-wrap .prefix { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); font-family: var(--mono); font-size: 14px; pointer-events: none; }
  #url {
    width: 100%;
    padding: 14px 16px 14px 64px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 15px;
    outline: none;
    transition: border .15s;
  }
  #url:focus { border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(56,189,248,.12); }
  #scanBtn {
    padding: 14px 30px;
    background: linear-gradient(135deg, #16a34a, #0d9488);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--mono);
    letter-spacing: .5px;
    transition: transform .1s, opacity .15s;
    white-space: nowrap;
  }
  #scanBtn:hover { transform: translateY(-1px); }
  #scanBtn:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  .hint { color: var(--muted); font-size: 12.5px; margin-top: 10px; font-family: var(--mono); }

  /* Scan history (v2) */
  .history { margin-top: 14px; display: none; }
  .history-label { font-family: var(--mono); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
  .hist-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .hist-chip {
    background: var(--bg-2); border: 1px solid var(--border); color: var(--muted);
    border-radius: 999px; padding: 5px 12px; font-family: var(--mono); font-size: 12px;
    cursor: pointer; transition: border .15s, color .15s; max-width: 100%; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap;
  }
  .hist-chip:hover { border-color: var(--cyan); color: var(--text); }
  .hist-chip b { font-weight: 700; }
  .hist-clear { background: none; border: none; color: #4a5a72; font-family: var(--mono); font-size: 11px; cursor: pointer; padding: 2px 4px; }
  .hist-clear:hover { color: var(--red); }

  /* Terminal log */
  #terminal {
    display: none;
    margin-top: 18px;
    background: #060a10;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px 16px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
    max-height: 220px;
    overflow-y: auto;
  }
  #terminal .ok { color: var(--green); }
  #terminal .warn { color: var(--yellow); }
  #terminal .err { color: var(--red); }
  #terminal .info { color: var(--muted); }
  .progress-track { display:none; margin-top: 14px; height: 6px; background: var(--bg-2); border-radius: 3px; overflow: hidden; }
  .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--cyan), var(--green)); transition: width .4s ease; }

  /* Summary */
  #summary { display: none; margin-top: 26px; }
  .score-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 26px;
    display: flex;
    gap: 30px;
    align-items: center;
    flex-wrap: wrap;
  }
  .gauge { position: relative; width: 130px; height: 130px; flex-shrink: 0; }
  .gauge svg { transform: rotate(-90deg); }
  .gauge .val {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .gauge .val b { font-size: 34px; font-family: var(--mono); }
  .gauge .val span { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
  .counts { flex: 1; min-width: 220px; }
  .counts h2 { font-size: 18px; margin-bottom: 4px; font-weight: 600; }
  .counts .target { color: var(--muted); font-family: var(--mono); font-size: 13px; margin-bottom: 16px; word-break: break-all; }
  .pill-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .pill {
    padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
    font-family: var(--mono); border: 1px solid transparent;
  }
  .pill.critical { background: rgba(248,113,113,.12); color: var(--red); border-color: rgba(248,113,113,.35); }
  .pill.high { background: rgba(251,146,60,.12); color: var(--orange); border-color: rgba(251,146,60,.35); }
  .pill.medium { background: rgba(250,204,21,.1); color: var(--yellow); border-color: rgba(250,204,21,.3); }
  .pill.low { background: rgba(96,165,250,.1); color: var(--blue); border-color: rgba(96,165,250,.3); }
  .pill.info { background: rgba(123,139,163,.12); color: var(--muted); border-color: rgba(123,139,163,.3); }
  .pill.pass { background: rgba(52,211,153,.1); color: var(--green); border-color: rgba(52,211,153,.3); }
  .summary-actions { margin-top: 22px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn2 {
    padding: 10px 18px; background: var(--bg-2); color: var(--text);
    border: 1px solid var(--border); border-radius: 8px; cursor: pointer;
    font-family: var(--mono); font-size: 13px; transition: border .15s;
  }
  .btn2:hover { border-color: var(--cyan); }

  /* Tech chips */
  #techBox { display: none; margin-top: 22px; }
  #techBox h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 1.2px; color: var(--muted); margin-bottom: 12px; font-family: var(--mono); }
  .chips { display: flex; flex-wrap: wrap; gap: 9px; }
  .chip {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 8px 14px; font-size: 13px; font-family: var(--mono);
    display: flex; align-items: center; gap: 8px;
  }
  .chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); }

  /* Findings */
  #findings { margin-top: 30px; display: none; }
  .section-title {
    font-family: var(--mono); font-size: 15px; letter-spacing: 1px;
    text-transform: uppercase; margin: 26px 0 14px; display: flex; align-items: center; gap: 10px;
  }
  .section-title::after { content: ""; flex: 1; height: 1px; background: var(--border); }
  .finding {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 11px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: border .15s;
  }
  .finding:hover { border-color: #2e4260; }
  .finding-head {
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    user-select: none;
  }
  .sev {
    font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 1px;
    padding: 4px 10px; border-radius: 5px; text-transform: uppercase; flex-shrink: 0; width: 78px; text-align: center;
  }
  .sev.critical { background: rgba(248,113,113,.15); color: var(--red); }
  .sev.high { background: rgba(251,146,60,.15); color: var(--orange); }
  .sev.medium { background: rgba(250,204,21,.12); color: var(--yellow); }
  .sev.low { background: rgba(96,165,250,.12); color: var(--blue); }
  .sev.info { background: rgba(123,139,163,.15); color: var(--muted); }
  .finding-title { flex: 1; font-weight: 600; font-size: 15px; }
  .finding-title small { display: block; color: var(--muted); font-weight: 400; font-size: 12.5px; margin-top: 3px; }
  .chev { color: var(--muted); transition: transform .2s; font-size: 12px; }
  .finding.open .chev { transform: rotate(90deg); }
  .finding-body { display: none; padding: 0 18px 18px; border-top: 1px solid var(--border); }
  .finding.open .finding-body { display: block; }
  .finding-body .desc { padding: 14px 0 6px; font-size: 14px; line-height: 1.65; color: #b9c6d9; }
  .fix-label {
    font-family: var(--mono); font-size: 11.5px; color: var(--green);
    text-transform: uppercase; letter-spacing: 1px; margin: 12px 0 8px;
    display: flex; align-items: center; gap: 8px;
  }
  .fix-label::before { content: "▸"; }
  pre.code {
    background: #060a10; border: 1px solid var(--border); border-radius: 8px;
    padding: 14px 16px; overflow-x: auto; font-family: var(--mono);
    font-size: 12.8px; line-height: 1.6; color: #a5d6ff; position: relative;
    white-space: pre;
  }
  .copy-btn {
    position: absolute; top: 8px; right: 8px;
    background: var(--bg-2); border: 1px solid var(--border); color: var(--muted);
    font-family: var(--mono); font-size: 11px; padding: 4px 10px;
    border-radius: 5px; cursor: pointer;
  }
  .copy-btn:hover { color: var(--text); border-color: var(--cyan); }
  .no-issues { text-align: center; padding: 40px; color: var(--green); font-family: var(--mono); }

  /* AI panel */
  #aiPanel { display: none; margin-top: 24px; }
  .ai-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
  .ai-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .ai-head h3 { font-size: 16px; font-family: var(--mono); letter-spacing: .5px; }
  .ai-badge { font-family: var(--mono); font-size: 11.5px; color: var(--cyan); background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.3); padding: 4px 10px; border-radius: 999px; }
  .ai-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .ai-row .ai-label { width: 220px; font-size: 13.5px; flex-shrink: 0; }
  .ai-track { flex: 1; height: 10px; background: var(--bg-2); border-radius: 5px; overflow: hidden; }
  .ai-fill { height: 100%; width: 0%; border-radius: 5px; transition: width .8s ease; background: var(--green); }
  .ai-pct { font-family: var(--mono); font-size: 13px; width: 52px; text-align: right; }
  .ai-level { font-family: var(--mono); font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 4px; letter-spacing: .5px; width: 82px; text-align: center; flex-shrink: 0; }
  .ai-level.low { background: rgba(52,211,153,.12); color: var(--green); }
  .ai-level.mod { background: rgba(250,204,21,.12); color: var(--yellow); }
  .ai-level.ele { background: rgba(251,146,60,.15); color: var(--orange); }
  .ai-level.hi  { background: rgba(248,113,113,.15); color: var(--red); }
  .ai-sig-title { font-family: var(--mono); font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; margin: 18px 0 10px; }
  .ai-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .ai-chip { font-family: var(--mono); font-size: 12px; background: rgba(56,189,248,.06); border: 1px solid rgba(56,189,248,.25); color: #a5d6ff; border-radius: 6px; padding: 5px 10px; }
  .ai-note { margin-top: 16px; color: var(--muted); font-size: 12px; line-height: 1.6; }

  .disclaimer {
    margin-top: 46px; text-align: center; color: var(--muted); font-size: 12.5px;
    line-height: 1.7; border-top: 1px solid var(--border); padding-top: 22px;
  }

  /* What's new (v2) */
  .whatsnew {
    margin-top: 18px; background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 18px; font-size: 13.5px; line-height: 1.7; color: var(--muted);
  }
  .whatsnew summary { cursor: pointer; font-family: var(--mono); font-size: 13px; color: var(--cyan); user-select: none; }
  .whatsnew ul { margin: 10px 0 0 18px; }
  .whatsnew li { margin-bottom: 5px; }
  .whatsnew b { color: var(--text); }
  footer { text-align: center; color: #4a5a72; font-size: 12px; margin-top: 26px; font-family: var(--mono); }

  /* Professional polish (v3.5) */
  header::after {
    content: ""; display: block; height: 2px; width: 200px; margin: 24px auto 0;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent); border-radius: 2px;
  }
  .wrap { animation: fadeup .45s ease both; }
  @keyframes fadeup { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .finding { box-shadow: 0 1px 3px rgba(0,0,0,.2); }
  .finding:hover { border-color: #2e4260; box-shadow: 0 8px 28px rgba(0,0,0,.35); }
  .score-card { box-shadow: 0 12px 44px rgba(0,0,0,.35); }

  /* Assistant chat (v3.5) */
  .chat-fab {
    position: fixed; right: 26px; bottom: 26px; width: 58px; height: 58px; border-radius: 50%;
    background: linear-gradient(135deg, #16a34a, #0d9488); border: none; color: #fff; font-size: 23px;
    cursor: pointer; box-shadow: 0 10px 30px rgba(13,148,136,.45); z-index: 60;
    transition: transform .15s, box-shadow .15s;
  }
  .chat-fab:hover { transform: translateY(-2px) scale(1.05); }
  .chat-panel {
    position: fixed; right: 26px; bottom: 98px; width: 384px; max-width: calc(100vw - 32px);
    height: 540px; max-height: calc(100vh - 130px); background: var(--card); border: 1px solid var(--border);
    border-radius: 16px; display: none; flex-direction: column; overflow: hidden; z-index: 61;
    box-shadow: 0 24px 70px rgba(0,0,0,.55);
  }
  .chat-panel.open { display: flex; }
  .chat-head {
    padding: 14px 18px; background: var(--card-2); border-bottom: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;
  }
  .chat-head b { font-family: var(--mono); font-size: 14px; letter-spacing: .5px; display: block; }
  .chat-head small { display: block; color: var(--muted); font-size: 11px; margin-top: 3px; line-height: 1.4; }
  #chatModeLbl { cursor: pointer; text-decoration: underline dotted; text-underline-offset: 2px; }
  .chat-close { background: none; border: none; color: var(--muted); font-size: 15px; cursor: pointer; padding: 2px 4px; }
  .chat-close:hover { color: var(--red); }
  .chat-body { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .chat-msg { max-width: 88%; padding: 10px 14px; border-radius: 14px; font-size: 13.5px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
  .chat-msg.bot { background: var(--bg-2); border: 1px solid var(--border); border-bottom-left-radius: 4px; align-self: flex-start; }
  .chat-msg.user { background: rgba(56,189,248,.12); border: 1px solid rgba(56,189,248,.3); border-bottom-right-radius: 4px; align-self: flex-end; }
  .chat-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 10px; }
  .chat-chip { background: var(--bg-2); border: 1px solid var(--border); color: var(--muted); border-radius: 999px; font-size: 11.5px; font-family: var(--mono); padding: 5px 10px; cursor: pointer; transition: border .15s, color .15s; }
  .chat-chip:hover { border-color: var(--cyan); color: var(--text); }
  .chat-input-row { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border); background: var(--card-2); }
  .chat-input-row input { flex: 1; background: var(--bg-2); border: 1px solid var(--border); border-radius: 9px; color: var(--text); font-size: 13.5px; padding: 10px 12px; outline: none; font-family: var(--sans); transition: border .15s; }
  .chat-input-row input:focus { border-color: var(--cyan); }
  .chat-send { background: linear-gradient(135deg, #16a34a, #0d9488); border: none; color: #fff; border-radius: 9px; width: 44px; cursor: pointer; font-size: 15px; transition: transform .1s; }
  .chat-send:hover { transform: translateY(-1px); }
  .chat-typing { display: inline-flex; gap: 4px; align-items: center; }
  .chat-typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: typing 1s infinite; }
  .chat-typing span:nth-child(2) { animation-delay: .18s; }
  .chat-typing span:nth-child(3) { animation-delay: .36s; }
  @keyframes typing { 0%, 100% { opacity: .25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
  @media (max-width: 640px) { .chat-panel { right: 12px; left: 12px; width: auto; } .chat-fab { right: 16px; bottom: 16px; } }

  /* Thoughts view (v4) */
  #thoughtsBox {
    display: none; margin-top: 18px; background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,.3);
  }
  .thoughts-head {
    display: flex; align-items: center; gap: 10px; padding: 14px 18px; cursor: pointer;
    user-select: none; background: var(--card-2); border-bottom: 1px solid var(--border);
  }
  .thoughts-head:hover { background: #1a2436; }
  .thoughts-head h3 { font-size: 13px; font-family: var(--mono); letter-spacing: 1px; color: var(--cyan); }
  .thoughts-caret { color: var(--muted); font-size: 11px; transition: transform .2s; width: 12px; }
  .thoughts-meta { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted); }
  .thoughts-body {
    max-height: 300px; overflow-y: auto; padding: 16px 18px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .thought {
    font-family: var(--mono); font-size: 12.8px; line-height: 1.7; color: #9fb0c8;
    padding: 2px 0 2px 14px; border-left: 2px solid var(--border);
    animation: fadeup .3s ease both;
  }
  .thought b { color: var(--text); font-weight: 600; }
  .thought .th-step { color: var(--cyan); font-weight: 700; }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="logo"><span class="bracket">[</span> BugHunter <span class="ver">v4.5</span> <span class="bracket">]</span><span class="cursor"></span></div>
    <p class="tagline">Website bug & vulnerability detector — scans for real issues and shows you <b>exactly how to fix them</b>. Now with a <b>8.27M-parameter transformer AI risk engine</b>, a live <b>Thoughts</b> reasoning view, and an AI chat assistant.</p>
  </header>

  <div class="scanbar">
    <div class="scan-row">
      <div class="url-wrap">
        <span class="prefix">https://</span>
        <input id="url" type="text" placeholder="example.com" spellcheck="false" autocomplete="off">
      </div>
      <button id="scanBtn">▶ RUN SCAN</button>
    </div>
    <div class="hint">$ enter a URL — checks: reachability · HTTPS/TLS · security headers · sensitive file exposure · outdated libraries · mixed content · SEO & HTML quality · AI risk model (8M transformer) · live Thoughts view</div>
    <div id="terminal"></div>
    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  </div>

  <div id="thoughtsBox">
    <div class="thoughts-head" id="thoughtsHead">
      <span class="thoughts-caret" id="thoughtsCaret">▼</span>
      <h3>◆ Thoughts</h3>
      <span class="thoughts-meta" id="thoughtsMeta">live reasoning trace</span>
    </div>
    <div class="thoughts-body" id="thoughtsBody"></div>
  </div>

  <div class="history" id="historyBox">
    <div class="history-label">Recent scans <button class="hist-clear" id="histClear" title="Clear history">✕ clear</button></div>
    <div class="hist-row" id="histRow"></div>
  </div>

  <div id="summary">
    <div class="score-card">
      <div class="gauge">
        <svg width="130" height="130" viewBox="0 0 130 130">
          <circle cx="65" cy="65" r="56" fill="none" stroke="#1a2436" stroke-width="10"/>
          <circle id="gaugeArc" cx="65" cy="65" r="56" fill="none" stroke="#34d399" stroke-width="10"
                  stroke-linecap="round" stroke-dasharray="351.86" stroke-dashoffset="351.86"
                  style="transition: stroke-dashoffset 1s ease, stroke .5s;"/>
        </svg>
        <div class="val"><b id="scoreVal">–</b><span>Score</span></div>
      </div>
      <div class="counts">
        <h2>Scan Report</h2>
        <div class="target" id="targetUrl"></div>
        <div class="pill-row" id="pillRow"></div>
        <div class="summary-actions">
          <button class="btn2" id="exportBtn">⬇ Download report (JSON)</button>
          <button class="btn2" id="rescanBtn">↻ Rescan</button>
        </div>
      </div>
    </div>
  </div>

  <div id="techBox">
    <h3>Detected Technologies</h3>
    <div class="chips" id="chips"></div>
  </div>

  <div id="aiPanel">
    <div class="ai-card">
      <div class="ai-head">
        <h3>AI Risk Analysis</h3>
        <span class="ai-badge">8.27M-parameter transformer · v4.5 · 6-layer multi-head self-attention · runs locally</span>
      </div>
      <div id="aiBars"></div>
      <div class="ai-sig-title">Top contributing signals</div>
      <div class="ai-chips" id="aiSignals"></div>
      <div class="ai-note">
        The AI layer is a REAL transformer — an 8,269,972-parameter encoder (v4.5): the page's 2,560 hashed tokens + 48 engineered
        features are split into 8 segments, embedded to 336 dimensions, and processed by 6 pre-LN self-attention layers (8 heads,
        336→1344→336 feed-forward) before 4 sigmoid heads give the risk probabilities. Trained offline, int8-quantized and embedded
        in this page. Inference runs 100% locally — no data leaves your browser. It complements, and does not replace, the rule-based findings.
      </div>
    </div>
  </div>

  <div id="findings"></div>

  <details class="whatsnew">
    <summary>◆ What's new in v4.5</summary>
    <ul>
      <li><b>Real transformer — 8,269,972 parameters</b> (7.02M MLP in v4): the risk model is now a genuine 6-layer, 8-head self-attention transformer encoder (336-dim, 1344 FFN), trained from scratch and verified (AUC ~1.00, quantized accuracy ≥ 99%).</li>
      <li><b>Real AI chat</b> — the assistant now answers through a large language model (online) with your scan results as context, so you can ask anything. If the AI service is unreachable it falls back to the built-in offline knowledge base.</li>
      <li><b>Richer Thoughts</b> — the reasoning trace now names the actual findings and dominant themes it discovers.</li>
      <li><b>Everything from v4</b> — Thoughts view, 30+ checks, scan history, saliency explanations, JSON reports.</li>
    </ul>
  </details>

  <p class="disclaimer">
    ⚠ Use this tool only on websites you own or have explicit permission to test. This is a passive, browser-side
    scanner — it fetches publicly reachable pages only and cannot replace a full penetration test.
  </p>    <footer>BugHunter v4.5 · single-file scanner + embedded 8.27M-parameter transformer AI + Thoughts view + AI chat · runs 100% in your browser</footer>
</div>

<button class="chat-fab" id="chatFab" title="Ask BugHunter">💬</button>
<div class="chat-panel" id="chatPanel">
  <div class="chat-head">
    <div><b>◆ BugHunter Assistant</b><small id="chatModeLbl" title="Toggle online / offline">⚡ online AI · ask anything — click to switch to offline KB</small></div>
    <button class="chat-close" id="chatClose" title="Close">✕</button>
  </div>
  <div class="chat-body" id="chatBody"></div>
  <div class="chat-chips" id="chatChips"></div>
  <div class="chat-input-row">
    <input id="chatInput" type="text" placeholder="Ask about your scan, a finding, or security…" autocomplete="off">
    <button class="chat-send" id="chatSend" title="Send">➤</button>
  </div>
</div>

<script>
"use strict";

const BH_VERSION = "4.5.0";

/* ============================== helpers ============================== */

const $ = (id) => document.getElementById(id);
const TERM = $("terminal");

function log(msg, cls = "info") {
  const line = document.createElement("div");
  line.className = cls;
  line.textContent = msg;
  TERM.appendChild(line);
  TERM.scrollTop = TERM.scrollHeight;
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function withTimeout(promiseFactory, ms) {
  return Promise.race([
    promiseFactory(),
    sleep(ms).then(() => { throw new Error("timeout"); })
  ]);
}

function esc(s) {
  const d = document.createElement("div");
  d.textContent = String(s);
  return d.innerHTML;
}

/* ============================== scan state ============================== */

let FINDINGS = [];
let TECH = [];
let LAST_REPORT = null;

function addFinding(sev, title, subtitle, desc, fix, code) {
  FINDINGS.push({ sev, title, subtitle, desc, fix, code: code || null });
}

/* ============================== network layer ============================== */

// Direct no-cors probe: resolves if the host is reachable at network level
// (DNS + TCP + TLS), rejects otherwise. Body/headers are opaque.
async function probeReachable(url, ms = 12000) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), ms);
  try {
    await fetch(url, { mode: "no-cors", signal: ctrl.signal, cache: "no-store", redirect: "follow" });
    return true;
  } catch (e) {
    return false;
  } finally { clearTimeout(t); }
}

// Try to fetch page content. Direct CORS first, then public proxies.
async function fetchPage(url) {
  // 1) direct (works if the site sends CORS headers)
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 12000);
    const res = await fetch(url, { signal: ctrl.signal, cache: "no-store" });
    clearTimeout(t);
    const headers = {};
    res.headers.forEach((v, k) => { headers[k.toLowerCase()] = v; });
    const text = await res.text();
    return { html: text, headers, via: "direct" };
  } catch (e) { /* fall through */ }

  // 2) corsproxy.io
  try {
    const r = await withTimeout(() =>
      fetch("https://corsproxy.io/?url=" + encodeURIComponent(url), { cache: "no-store" }), 18000);
    if (r.ok) {
      const text = await r.text();
      return { html: text, headers: {}, via: "proxy1" };
    }
  } catch (e) { /* fall through */ }

  // 3) allorigins JSON gateway (gives status code too)
  try {
    const r = await withTimeout(() =>
      fetch("https://api.allorigins.win/get?url=" + encodeURIComponent(url), { cache: "no-store" }), 20000);
    const j = await r.json();
    if (j && j.contents != null) {
      return { html: j.contents, headers: {}, via: "proxy2", status: j.status };
    }
  } catch (e) { /* fall through */ }

  // 4) codetabs proxy fallback
  try {
    const r = await withTimeout(() =>
      fetch("https://api.codetabs.com/v1/proxy?quest=" + encodeURIComponent(url), { cache: "no-store" }), 20000);
    if (r.ok) {
      const text = await r.text();
      return { html: text, headers: {}, via: "proxy2" };
    }
  } catch (e) { /* fall through */ }

  return null;
}

// Fetch a URL + status code (for path checks). Tries allorigins (exact code)
// then corsproxy (its status mirrors the target's).
async function fetchWithStatus(url) {
  try {
    const r = await withTimeout(() =>
      fetch("https://api.allorigins.win/get?url=" + encodeURIComponent(url), { cache: "no-store" }), 18000);
    const j = await r.json();
    if (j && j.status) {
      return { code: j.status.http_code, body: j.contents || "" };
    }
  } catch (e) {}
  try {
    const r = await withTimeout(() =>
      fetch("https://corsproxy.io/?url=" + encodeURIComponent(url), { cache: "no-store" }), 15000);
    const body = await r.text();
    return { code: r.status, body: body };
  } catch (e) {}
  return null;
}

/* ============================== checks ============================== */

const TECH_SIGNATURES = [
  { name: "WordPress",  test: h => /wp-content|wp-includes|wp-json/i.test(h) },
  { name: "React",      test: h => /data-reactroot|__NEXT_DATA__|react(-dom)?(\.min)?\.js|_reactListening/i.test(h) },
  { name: "Next.js",    test: h => /__NEXT_DATA__|\/_next\//i.test(h) },
  { name: "Vue.js",     test: h => /data-v-app|vue(\.runtime)?(\.min)?\.js|v-if=/i.test(h) },
  { name: "Angular",    test: h => /ng-version|angular(\.min)?\.js/i.test(h) },
  { name: "jQuery",     test: h => /jquery/i.test(h) },
  { name: "Bootstrap",  test: h => /bootstrap(\.min)?\.(css|js)/i.test(h) },
  { name: "Tailwind",   test: h => /tailwind/i.test(h) },
  { name: "Laravel",    test: h => /name="csrf-token"|laravel_session|XSRF-TOKEN/i.test(h) },
  { name: "Cloudflare", test: h => /cdn-cgi|cloudflare/i.test(h) },
  { name: "Google Analytics", test: h => /google-analytics\.com|gtag\(/i.test(h) },
  { name: "Google Fonts",    test: h => /fonts\.(googleapis|gstatic)\.com/i.test(h) },
  { name: "Font Awesome",    test: h => /font-?awesome/i.test(h) },
  { name: "PHP",       test: h => /\.php|PHPSESSID/i.test(h) },
  { name: "Shopify",   test: h => /cdn\.shopify\.com|shopify/i.test(h) },
  { name: "Wix",       test: h => /wix(static|site)/i.test(h) },
  { name: "Squarespace", test: h => /squarespace/i.test(h) },
  { name: "Drupal",    test: h => /drupal|sites\/default\/files/i.test(h) },
  { name: "Nuxt",      test: h => /__nuxt|nuxt/i.test(h) },
  { name: "Svelte",    test: h => /svelte/i.test(h) },
];

function checkSecurityHeaders(headers, isHttps) {
  const h = headers;
  const wanted = [
    ["content-security-policy", "high", "No Content-Security-Policy header",
      "Without CSP the browser allows scripts from anywhere, which makes XSS far more damaging.",
      "Add a Content-Security-Policy header on your web server / CDN.",
      'Content-Security-Policy: default-src \'self\'; script-src \'self\'; object-src \'none\'; frame-ancestors \'self\'; base-uri \'self\';'],
    ["strict-transport-security", "medium", "No Strict-Transport-Security (HSTS) header",
      "Without HSTS a user can be tricked into visiting the site over plain HTTP (SSL-strip attacks).",
      "Enable HSTS once you are sure HTTPS works for all subdomains.",
      'Strict-Transport-Security: max-age=31536000; includeSubDomains'],
    ["x-frame-options", "low", "No X-Frame-Options / frame-ancestors protection",
      "The site can be embedded in an iframe, enabling clickjacking attacks (the modern CSP frame-ancestors directive also fixes this).",
      "Send X-Frame-Options, or better, the CSP frame-ancestors directive.",
      'X-Frame-Options: DENY'],
    ["x-content-type-options", "low", "No X-Content-Type-Options header",
      "Browsers may MIME-sniff responses and execute an innocent file as script.",
      "Stop MIME sniffing with one header.",
      'X-Content-Type-Options: nosniff'],
    ["referrer-policy", "low", "No Referrer-Policy header",
      "Full URLs (including query strings with tokens/session IDs) can leak to third-party sites via the Referer header.",
      "Set a restrictive Referrer-Policy.",
      'Referrer-Policy: strict-origin-when-cross-origin'],
  ];
  for (const [key, sev, title, desc, fix, code] of wanted) {
    if (isHttps === false && key === "strict-transport-security") continue; // pointless without TLS
    if (!h[key]) addFinding(sev, title, "Missing security header", desc, fix, code);
  }
}

function checkHtml(html, pageUrl, isHttps) {
  const doc = new DOMParser().parseFromString(html, "text/html");

  /* ---- technology detection ---- */
  for (const t of TECH_SIGNATURES) {
    try { if (t.test(html)) TECH.push(t.name); } catch (e) {}
  }

  /* ---- jQuery version ---- */
  const jq = html.match(/jquery[.\-\/]?(\d+)\.(\d+)(\.(\d+))?/i);
  if (jq && parseInt(jq[1], 10) < 3) {
    addFinding("high", "Outdated jQuery " + jq[1] + "." + jq[2] + " detected",
      "Known vulnerabilities",
      "jQuery before 3.x (especially 1.x) has publicly known XSS and prototype-pollution vulnerabilities (e.g. CVE-2020-11022/11023 in <3.5). Attackers actively scan for old jQuery.",
      "Upgrade to the latest jQuery 3.x. If you cannot, at minimum upgrade to 3.5.0+.",
      '<script src="https://code.jquery.com/jquery-3.7.1.min.js"><\/script>');
  }

  /* ---- title ---- */
  const title = (doc.querySelector("title") && doc.querySelector("title").textContent.trim()) || "";
  if (!title) {
    addFinding("medium", "Missing or empty <title> tag", "SEO & usability",
      "The page title is what shows in search results and browser tabs. An empty title hurts ranking and looks broken.",
      "Add a unique, descriptive title (50–60 characters).",
      "<title>Acme Tools — Free Online PDF Editor</title>");
  } else if (title.length > 65) {
    addFinding("low", "Page title is too long (" + title.length + " chars)", "SEO",
      "Google truncates titles around 60 characters in search results.",
      "Keep titles between 50 and 60 characters.", null);
  }

  /* ---- meta description ---- */
  const md = doc.querySelector('meta[name="description" i]');
  if (!md || !md.getAttribute("content") || !md.getAttribute("content").trim()) {
    addFinding("medium", "Missing meta description", "SEO",
      "Search engines show the meta description under your link. Without it, Google invents a snippet.",
      "Add a compelling 120–160 character description.",
      '<meta name="description" content="Fix bugs and detect vulnerabilities in any website with BugHunter, a free browser-based scanner.">');